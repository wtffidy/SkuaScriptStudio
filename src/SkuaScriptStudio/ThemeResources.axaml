<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Original Potato Studio direction: midnight plum, electric violet, hot pink and toasted-gold potato accents. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#160D20" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#24132F" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#30183D" />
  <SolidColorBrush x:Key="SurfaceInsetBrush" Color="#190F24" />
  <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#100B18" />
  <SolidColorBrush x:Key="BorderBrush" Color="#713B83" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#D75BEA" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4FF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E2CBEA" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#B99AC8" />
  <SolidColorBrush x:Key="TextSubtleBrush" Color="#9574A8" />
  <SolidColorBrush x:Key="EditorTextBrush" Color="#F9EDFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#9828D8" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#F2A5FF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#C34BEE" />
  <SolidColorBrush x:Key="PotatoGoldBrush" Color="#FFC45E" />
  <SolidColorBrush x:Key="FooterBrush" Color="#2A1638" />
</ResourceDictionary>
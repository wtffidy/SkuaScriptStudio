<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkuaScriptStudio.Assets.PotatoBackgroundArtwork"
             IsHitTestVisible="False">
  <Grid ClipToBounds="True">
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#15111D" Offset="0"/>
          <GradientStop Color="#21152C" Offset="0.52"/>
          <GradientStop Color="#17121F" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Canvas>
      <Ellipse Canvas.Left="-110" Canvas.Top="-100" Width="360" Height="360" Fill="#49265F" Opacity="0.20"/>
      <Ellipse Canvas.Right="-120" Canvas.Bottom="-140" Width="420" Height="420" Fill="#62327A" Opacity="0.14"/>
      <Ellipse Canvas.Left="230" Canvas.Top="360" Width="74" Height="94" Fill="#B67A43" Opacity="0.09"/>
      <Ellipse Canvas.Left="248" Canvas.Top="382" Width="38" Height="10" Fill="#6D3B35" Opacity="0.12"/>
      <Ellipse Canvas.Left="640" Canvas.Top="100" Width="56" Height="70" Fill="#C08A50" Opacity="0.07"/>
      <Ellipse Canvas.Left="652" Canvas.Top="116" Width="29" Height="8" Fill="#6D3B35" Opacity="0.10"/>
      <Ellipse Canvas.Right="160" Canvas.Top="280" Width="84" Height="102" Fill="#C08A50" Opacity="0.07"/>
      <TextBlock Canvas.Left="52" Canvas.Top="74" Text="✦" FontSize="24" Foreground="#C77CF0" Opacity="0.22"/>
      <TextBlock Canvas.Right="90" Canvas.Top="120" Text="✧" FontSize="34" Foreground="#D7A85D" Opacity="0.20"/>
      <TextBlock Canvas.Right="280" Canvas.Bottom="64" Text="🥔" FontSize="76" Opacity="0.055"/>
    </Canvas>
  </Grid>
</UserControl>
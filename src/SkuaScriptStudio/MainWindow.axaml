<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:art="using:SkuaScriptStudio.Assets"
        x:Class="SkuaScriptStudio.MainWindow"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Title="Skua Script Studio"
        Icon="/Assets/skua-script-studio.ico"
        Closing="MainWindow_OnClosing"
        KeyDown="MainWindow_OnKeyDown">
  <Grid RowDefinitions="82,*">
    <Border Grid.Row="0" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#30183F" Offset="0"/>
          <GradientStop Color="#1C1427" Offset="0.55"/>
          <GradientStop Color="#382044" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <art:PotatoTitleBarArtwork Opacity="0.32"/>
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="14" Background="#49265F" BorderBrush="#B77CE8" BorderThickness="1">
            <TextBlock Text="🥔" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="SKUA SCRIPT STUDIO" FontWeight="Bold" FontSize="15" LetterSpacing="1"/>
            <TextBlock Text="POTATO POWERED DEVELOPMENT" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Write  •  Build  •  Script" Foreground="{DynamicResource AccentTextBrush}" FontSize="17" FontStyle="Italic" HorizontalAlignment="Center"/>
          <TextBlock Text="YOUR SKUA WORKSPACE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Center" LetterSpacing="2"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Name="OpenButton" Content="Open" Click="OpenButton_OnClick"/>
          <Button Name="UpdateButton" Content="Check for updates" Click="UpdateButton_OnClick"/>
          <Button Name="SaveButton" Content="Save" Click="SaveButton_OnClick" Background="{DynamicResource AccentBrush}"/>
        </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="5">
            <TextBlock Text="WORKSPACE" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" FontWeight="Bold" Margin="10,8,0,8"/>
            <Button Classes="nav" Content="⌂   Home" Click="HomeNav_OnClick"/>
            <Button Classes="nav" Content="⌨   Editor" Click="EditorNav_OnClick"/>
            <Button Classes="nav" Content="✣   Visual Builder" Click="BuilderNav_OnClick"/>
            <Button Classes="nav" Content="▤   Script Library" Click="LibraryNav_OnClick"/>
            <Button Classes="nav" Content="⌁   Diagnostics" Click="DiagnosticsNav_OnClick"/>
            <TextBlock Text="TOOLS" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" FontWeight="Bold" Margin="10,24,0,8"/>
            <Button Classes="nav" Content="◇   Snippets" Click="SnippetsNav_OnClick"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="5">
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>
            <TextBlock Text="SKUA SCRIPT STUDIO" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="10,5,0,0"/>
            <TextBlock Text="Foundation build · 0.1.0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="10,0,0,5"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28">
        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="14" IsHitTestVisible="False">
          <Grid ClipToBounds="True">
            <art:PotatoBackgroundArtwork/>
            <Ellipse Width="300" Height="300" Fill="#251735" Opacity="0.28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-130,-100,0"/>
            <Ellipse Width="220" Height="220" Fill="#392047" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-90"/>
          </Grid>
        </Border>
        <TabControl Name="WorkspaceTabs" Background="Transparent" BorderThickness="0">
          <TabItem Header="Home">
            <ScrollViewer>
              <StackPanel Spacing="18" Margin="4,18">
                <Border CornerRadius="16" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Padding="24">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#3A204B" Offset="0"/>
                      <GradientStop Color="#24172F" Offset="0.62"/>
                      <GradientStop Color="#191421" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="7" VerticalAlignment="Center">
                      <TextBlock Text="WELCOME TO YOUR WORKSPACE" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" FontWeight="Bold" LetterSpacing="2"/>
                      <TextBlock Text="Skua Script Studio" FontSize="30" FontWeight="Bold"/>
                      <TextBlock Text="Write, build and manage your Skua scripts — all in one place." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                      <TextBlock Text="Potatoes. Power. Productivity." Foreground="{DynamicResource PotatoGoldBrush}" FontSize="12" FontStyle="Italic" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="116" Height="116" CornerRadius="58" Background="#352344" BorderBrush="#8155A3" BorderThickness="1" VerticalAlignment="Center">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                        <TextBlock Text="👑" FontSize="25" HorizontalAlignment="Center"/>
                        <TextBlock Text="🥔" FontSize="62" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="8">
                      <TextBlock Text="01  EDITOR" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" FontWeight="Bold"/>
                      <TextBlock Text="Write real C#" FontSize="19" FontWeight="SemiBold"/>
                      <TextBlock Text="Open, edit and save your scripts in one workspace." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <Button Content="Open editor →" HorizontalAlignment="Left" Click="EditorNav_OnClick"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="8">
                      <TextBlock Text="02  BUILDER" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" FontWeight="Bold"/>
                      <TextBlock Text="Start from blocks" FontSize="19" FontWeight="SemiBold"/>
                      <TextBlock Text="Configure common Skua actions and generate editable C#." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <Button Content="Open builder →" HorizontalAlignment="Left" Click="BuilderNav_OnClick"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="8">
                      <TextBlock Text="03  LIBRARY" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" FontWeight="Bold"/>
                      <TextBlock Text="Keep it organized" FontSize="19" FontWeight="SemiBold"/>
                      <TextBlock Text="Build a reusable local collection of scripts and templates." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <Button Content="Open library →" HorizontalAlignment="Left" Click="LibraryNav_OnClick"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                  <StackPanel Spacing="8">
                    <TextBlock Text="GETTING STARTED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                    <TextBlock Text="This is the foundation build." FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The editor can open and save C# files, the local library can import, search, open and remove script copies, and the visual builder assembles complete scripts from guided actions. Add steps, arrange their order, and build the finished script." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Editor">
            <Grid RowDefinitions="Auto,* ,Auto" Margin="4,16">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Spacing="3">
                  <TextBlock Name="DocumentNameText" Text="Untitled.cs" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="C# SOURCE" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="Open file" Click="OpenButton_OnClick"/>
                  <Button Content="Save file" Background="{DynamicResource AccentBrush}" Click="SaveButton_OnClick"/>
                </StackPanel>
              </Grid>
              <TextBox Name="EditorTextBox" Grid.Row="1" Classes="editor" TextChanged="EditorTextBox_OnTextChanged" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Watermark="// Your Skua C# script goes here..."/>
              <Border Grid.Row="2" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                <TextBlock Name="EditorStatusText" Text="Ready · Local editing" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Visual Builder">
            <ScrollViewer>
              <StackPanel Spacing="18" Margin="4,18">
                <StackPanel Spacing="5">
                  <TextBlock Text="Build a script" FontSize="28" FontWeight="Bold"/>
                  <TextBlock Text="Assemble a visual command flow. Add actions, wrap them in inventory conditions or repeat-until loops, reorder blocks, then generate editable Skua C#." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="1. CHOOSE A BLOCK" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Build the bot flow" FontSize="19" FontWeight="SemiBold"/>
                      </StackPanel>
                      <ComboBox Name="BuilderActionInput" SelectedIndex="0" SelectionChanged="BuilderActionInput_OnSelectionChanged">
                        <ComboBoxItem Content="Hunt for an item"/>
                        <ComboBoxItem Content="Accept a quest"/>
                        <ComboBoxItem Content="Complete a quest"/>
                        <ComboBoxItem Content="Equip a class"/>
                        <ComboBoxItem Content="Travel to a map"/>
                        <ComboBoxItem Content="Check inventory"/>
                        <ComboBoxItem Content="Log a message"/>
                        <ComboBoxItem Content="Wait"/>
                        <ComboBoxItem Content="Wait for an item"/>
                        <ComboBoxItem Content="Equip gear"/>
                        <ComboBoxItem Content="Move to a cell"/>
                        <ComboBoxItem Content="Add drops"/>
                        <ComboBoxItem Content="Remove drops"/>
                        <ComboBoxItem Content="Bank items"/>
                        <ComboBoxItem Content="Unbank items"/>
                        <ComboBoxItem Content="Log farming progress"/>
                        <ComboBoxItem Content="Rest"/>
                        <ComboBoxItem Content="Configure aggro"/>
                        <ComboBoxItem Content="If item missing"/>
                        <ComboBoxItem Content="Repeat until item owned"/>
                        <ComboBoxItem Content="End block"/>
                        <ComboBoxItem Content="End repeat"/>
                      </ComboBox>
                      <TextBlock Text="2. FILL IN THE DETAILS" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,8,0,0"/>
                      <TextBlock Name="BuilderActionHelpText" Text="Choose an action to see exactly what information it needs." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Name="BuilderMapField" Spacing="4">
                          <TextBlock Text="Map name"/>
                          <TextBox Name="BuilderMapInput" Watermark="e.g. battleundere"/>
                        </StackPanel>
                        <StackPanel Name="BuilderTargetField" Grid.Column="1" Spacing="4">
                          <TextBlock Text="Monster / target"/>
                          <TextBox Name="BuilderTargetInput" Watermark="e.g. Treasure Pile"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Name="BuilderItemField" Spacing="4">
                          <TextBlock Text="Item name"/>
                          <TextBox Name="BuilderItemInput" Watermark="e.g. Treasure Relic"/>
                        </StackPanel>
                        <StackPanel Name="BuilderQuantityField" Grid.Column="1" Spacing="4">
                          <TextBlock Text="Quantity / seconds"/>
                          <NumericUpDown Name="BuilderQuantityInput" Minimum="1" Maximum="100000" Value="1"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Name="BuilderValueField" Spacing="4">
                        <TextBlock Name="BuilderValueLabel" Text="Quest ID / message"/>
                        <TextBox Name="BuilderValueInput" Watermark="Quest number or text to log"/>
                      </StackPanel>
                      <Grid Name="BuilderCellFields" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Cell"/>
                          <TextBox Name="BuilderCellInput" Text="Enter"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="Pad"/>
                          <TextBox Name="BuilderPadInput" Text="Spawn"/>
                        </StackPanel>
                      </Grid>
                      <CheckBox Name="BuilderEnabledInput" Content="Enable aggro handling" IsChecked="True"/>
                      <StackPanel Name="BuilderClassField" Spacing="4">
                        <TextBlock Text="Class to equip"/>
                        <ComboBox Name="BuilderClassInput" SelectedIndex="0">
                          <ComboBoxItem Content="Farm"/>
                          <ComboBoxItem Content="Solo"/>
                          <ComboBoxItem Content="Support"/>
                        </ComboBox>
                      </StackPanel>
                      <Button Name="AddBuilderStepButton" Content="＋ Add this step" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Stretch" Padding="14,10" Click="AddBuilderStepButton_OnClick"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Text="3. YOUR SCRIPT" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="Bold"/>
                          <TextBlock Text="Block workspace" FontSize="19" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Name="BuilderStepCountText" Grid.Column="1" Text="0 STEP(S)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                      </Grid>
                      <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="8" Padding="8" MinHeight="280">
                        <ListBox Name="BuilderStepsList" Background="Transparent"/>
                      </Border>
                      <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                        <Button Content="↑ Up" Click="MoveBuilderStepUpButton_OnClick"/>
                        <Button Grid.Column="1" Content="↓ Down" Click="MoveBuilderStepDownButton_OnClick"/>
                        <Button Grid.Column="2" Content="Edit" Click="EditBuilderStepButton_OnClick"/>
                        <Button Grid.Column="3" Content="Remove" Click="RemoveBuilderStepButton_OnClick"/>
                        <Button Name="ClearBuilderButton" Grid.Column="4" Content="Clear all" Click="ClearBuilderButton_OnClick"/>
                      </Grid>
                      <StackPanel Grid.Row="3" Spacing="8">
                        <TextBlock Name="BuilderStatusText" Text="Start by adding your first action. Your steps will run from top to bottom." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Name="BuildScriptButton" Content="Build my complete script  →" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Stretch" Padding="16,12" IsEnabled="False" Click="BuildScriptButton_OnClick"/>
                        <TextBlock Text="Use IF / END IF and REPEAT / END REPEAT blocks to create structured logic. Generated C# opens in the editor for review." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Library">
            <Grid RowDefinitions="Auto,Auto,*" Margin="4,18">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Spacing="5">
                  <TextBlock Text="Script Library" FontSize="26" FontWeight="Bold"/>
                  <TextBlock Name="LibraryCountText" Text="0 SCRIPT(S)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
                <Button Grid.Column="1" Content="＋ Import scripts" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Click="ImportToLibraryButton_OnClick"/>
              </Grid>
              <TextBox Name="LibrarySearchInput" Grid.Row="1" Watermark="Search your local scripts..." Margin="0,0,0,12" TextChanged="LibrarySearchInput_OnTextChanged"/>
              <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <ListBox Name="LibraryList" Background="{DynamicResource SurfaceRaisedBrush}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                  <Button Content="Open selected" Background="{DynamicResource AccentBrush}" Click="OpenLibraryButton_OnClick"/>
                  <Button Content="Remove from library" Click="RemoveLibraryButton_OnClick"/>
                </StackPanel>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Diagnostics">
            <Grid RowDefinitions="Auto,Auto,*" Margin="4,18">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Spacing="5">
                  <TextBlock Text="Diagnostics" FontSize="26" FontWeight="Bold"/>
                  <TextBlock Name="DiagnosticsCountText" Text="RUN ANALYSIS TO CHECK THE CURRENT SCRIPT" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Analyze current script" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Click="AnalyzeButton_OnClick"/>
              </Grid>
              <TextBlock Grid.Row="1" Text="Roslyn C# parser diagnostics · syntax errors and warnings with line and column locations" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
              <ListBox Name="DiagnosticsList" Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" SelectionChanged="DiagnosticsList_OnSelectionChanged"/>
            </Grid>
          </TabItem>

          <TabItem Header="Snippets">
            <Grid ColumnDefinitions="280,*" ColumnSpacing="18" Margin="4,18">
              <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <Grid><TextBlock Text="Code Snippets" FontSize="24" FontWeight="Bold"/><TextBlock Name="SnippetCountText" Text="0 SNIPPETS" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                <TextBlock Grid.Row="1" Text="CORE LIBRARY" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,4"/>
                <ComboBox Name="SnippetCoreFilter" Grid.Row="2" SelectionChanged="SnippetFilter_OnSelectionChanged"/>
                <ComboBox Name="SnippetCategoryFilter" Grid.Row="3" Margin="0,8,0,8" SelectionChanged="SnippetFilter_OnSelectionChanged"/>
                <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBox Name="SnippetSearchInput" Watermark="Search names, descriptions or code..." TextChanged="SnippetSearchInput_OnTextChanged"/>
                  <ListBox Name="SnippetsList" Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" SelectionChanged="SnippetsList_OnSelectionChanged"/>
                </Grid>
              </Grid>
              <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="18">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                  <TextBlock Text="Snippet preview" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Name="SnippetDescriptionText" Grid.Row="1" Text="Select a snippet to see what it does." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  <TextBox Name="SnippetPreviewText" Grid.Row="2" Classes="editor" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                  <Button Grid.Row="3" Content="Insert into editor  →" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Click="InsertSnippetButton_OnClick"/>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </Grid>
</Window>
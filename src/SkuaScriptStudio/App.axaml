<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkuaScriptStudio.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SkuaScriptStudio/ThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Background" Value="#55365D" />
      <Setter Property="BorderBrush" Value="#A66B91" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#754887" />
      <Setter Property="BorderBrush" Value="{DynamicResource PotatoGoldBrush}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#392343" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Background" Value="#432B4B" />
      <Setter Property="BorderBrush" Value="#654568" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#654078" />
      <Setter Property="BorderBrush" Value="{DynamicResource PotatoGoldBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#241A2B" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="#785477" />
      <Setter Property="SelectionBrush" Value="#A45CC7" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#49304F" />
      <Setter Property="BorderBrush" Value="#91638A" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#2A1E32" />
      <Setter Property="BorderBrush" Value="#76506F" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.editor">
      <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
      <Setter Property="BorderBrush" Value="#785477" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Application.Styles>
</Application>